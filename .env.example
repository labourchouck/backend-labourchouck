NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/labourchowck
JWT_SECRET=change-me-to-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Plain OTP is printed to the server terminal when NODE_ENV is not production.
# Set to true to also print OTP when NODE_ENV=production (e.g. staging only).
OTP_DEV_LOG=true
# Client review: OTP = last 6 digits of mobile (e.g. 9876543210 → 543210).
# Auto-on when NODE_ENV is not production; set true on production demo hosts.
OTP_BYPASS_LAST6=true
SEED_ADMIN_EMAIL=admin@labourchowck.local
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_PHONE=8999999999
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
# SMS (SMSGatewayHub-style DLT transactional API) - used by otpService for real OTP delivery
SMS_API_KEY=your-sms-gateway-api-key
SMS_SENDER_ID=BGADEC
SMS_PE_ID=your-dlt-principal-entity-id
OTP_TEMPLATE_ID=your-dlt-otp-template-id
# SMS_ROUTE=4
# SMS_SEND_ALWAYS=false
# Path to the Firebase Admin service account JSON (for FCM push notifications).
# Defaults to src/config/labourchowck.json if unset.
FIREBASE_SERVICE_ACCOUNT_PATH=src/config/labourchowck.json
